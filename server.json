{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.askmojood/chatwoot-mcp",
  "title": "Chatwoot (Mojood Connect)",
  "description": "Chatwoot inbox in Claude: find conversations, add private notes, hand over after a yes.",
  "repository": {
    "url": "https://github.com/askmojood/chatwoot-mcp",
    "source": "github"
  },
  "websiteUrl": "https://mojood.app/connect",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mojood-chatwoot-mcp",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--stdio",
          "valueHint": "--stdio"
        }
      ],
      "environmentVariables": [
        {
          "name": "CHATWOOT_URL",
          "description": "Your Chatwoot address",
          "isSecret": false,
          "isRequired": true
        },
        {
          "name": "CHATWOOT_ACCOUNT",
          "description": "The account id",
          "isSecret": false,
          "isRequired": true
        },
        {
          "name": "CHATWOOT_TOKEN",
          "description": "A user's API access token",
          "isSecret": true,
          "isRequired": true
        },
        {
          "name": "CHATWOOT_SAMPLE",
          "description": "0 for real data (1 labels answers SAMPLE)",
          "isSecret": false,
          "isRequired": false
        }
      ]
    }
  ]
}
